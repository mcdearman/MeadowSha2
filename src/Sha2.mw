use Std.St as St
use Std.Collections.Vector as V
use Sha2.Tables

-- --- words ------------------------------------------------------------------------------

fun hexDigit s i =
  let c = toInt (stringByteAt s i) in
  if c <= 57 then c - 48 else c - 87

-- The 32-bit words written as hex in `s`.
fun words32 s =
  runSt (\() ->
    let n = stringByteLength s / 8 in
    let a = St.newArray n (toUInt32 0) in
    let _ =
      St.forRange 0 n (\k ->
        let rec go j w = if j >= 8 then w else go (j + 1) (bitOr (w << 4) (toUInt32 (hexDigit s (8 * k + j)))) in
        St.set a k (go 0 (toUInt32 0)))
    in
    St.freeze a)

-- The 64-bit words written as hex in `s`.
fun words64 s =
  runSt (\() ->
    let n = stringByteLength s / 16 in
    let a = St.newArray n (toUInt64 0) in
    let _ =
      St.forRange 0 n (\k ->
        let rec go j w = if j >= 16 then w else go (j + 1) (bitOr (w << 4) (toUInt64 (hexDigit s (16 * k + j)))) in
        St.set a k (go 0 (toUInt64 0)))
    in
    St.freeze a)

def rounds32 = words32 k32

def rounds64 = words64 k64

fun rotr32 x n = bitOr (x >> n) (x << (32 - n))

fun rotr64 x n = bitOr (x >> n) (x << (64 - n))

-- --- compression ------------------------------------------------------------------------

-- `state` after the 64-byte block of `bytes` at `at`.
fun compress32 (state : #[UInt32]) (bytes : #[UInt8]) at =
  runSt (\() ->
    let w = St.newArray 64 (toUInt32 0) in
    let byte = \i -> toUInt32 (arrayGet bytes (at + i)) in
    let _ =
      St.forRange 0 16 (\i ->
        let high = bitOr (byte (4 * i) << 24) (byte (4 * i + 1) << 16) in
        St.set w i (bitOr high (bitOr (byte (4 * i + 2) << 8) (byte (4 * i + 3)))))
    in
    let _ =
      St.forRange 16 64 (\i ->
        let w15 = St.get w (i - 15) in
        let s0 = bitXor (bitXor (rotr32 w15 7) (rotr32 w15 18)) (w15 >> 3) in
        let w2 = St.get w (i - 2) in
        let s1 = bitXor (bitXor (rotr32 w2 17) (rotr32 w2 19)) (w2 >> 10) in
        St.set w i (St.get w (i - 16) + s0 + St.get w (i - 7) + s1))
    in
    let rec round i a b c d e f g h =
      if i >= 64
      then [a, b, c, d, e, f, g, h]
      else
        let s1 = bitXor (bitXor (rotr32 e 6) (rotr32 e 11)) (rotr32 e 25) in
        let ch = bitXor (bitAnd e f) (bitAnd (bitNot e) g) in
        let t1 = s1 + ch + arrayGet rounds32 i + St.get w i + h in
        let s0 = bitXor (bitXor (rotr32 a 2) (rotr32 a 13)) (rotr32 a 22) in
        let maj = bitXor (bitXor (bitAnd a b) (bitAnd a c)) (bitAnd b c) in
        let t2 = s0 + maj in
        round (i + 1) (t1 + t2) a b c (d + t1) e f g
    in
    let s = \k -> arrayGet state k in
    let out = round 0 (s 0) (s 1) (s 2) (s 3) (s 4) (s 5) (s 6) (s 7) in
    let result = St.newArray 8 (toUInt32 0) in
    let _ = St.forRange 0 8 (\k -> St.set result k (s k + V.getOr (toUInt32 0) out k)) in
    St.freeze result)

-- `state` after the 128-byte block of `bytes` at `at`.
fun compress64 (state : #[UInt64]) (bytes : #[UInt8]) at =
  runSt (\() ->
    let w = St.newArray 80 (toUInt64 0) in
    let byte = \i -> toUInt64 (arrayGet bytes (at + i)) in
    let _ =
      St.forRange 0 16 (\i ->
        let rec go j acc = if j >= 8 then acc else go (j + 1) (bitOr (acc << 8) (byte (8 * i + j))) in
        St.set w i (go 0 (toUInt64 0)))
    in
    let _ =
      St.forRange 16 80 (\i ->
        let w15 = St.get w (i - 15) in
        let s0 = bitXor (bitXor (rotr64 w15 1) (rotr64 w15 8)) (w15 >> 7) in
        let w2 = St.get w (i - 2) in
        let s1 = bitXor (bitXor (rotr64 w2 19) (rotr64 w2 61)) (w2 >> 6) in
        St.set w i (St.get w (i - 16) + s0 + St.get w (i - 7) + s1))
    in
    let rec round i a b c d e f g h =
      if i >= 80
      then [a, b, c, d, e, f, g, h]
      else
        let s1 = bitXor (bitXor (rotr64 e 14) (rotr64 e 18)) (rotr64 e 41) in
        let ch = bitXor (bitAnd e f) (bitAnd (bitNot e) g) in
        let t1 = s1 + ch + arrayGet rounds64 i + St.get w i + h in
        let s0 = bitXor (bitXor (rotr64 a 28) (rotr64 a 34)) (rotr64 a 39) in
        let maj = bitXor (bitXor (bitAnd a b) (bitAnd a c)) (bitAnd b c) in
        let t2 = s0 + maj in
        round (i + 1) (t1 + t2) a b c (d + t1) e f g
    in
    let s = \k -> arrayGet state k in
    let out = round 0 (s 0) (s 1) (s 2) (s 3) (s 4) (s 5) (s 6) (s 7) in
    let result = St.newArray 8 (toUInt64 0) in
    let _ = St.forRange 0 8 (\k -> St.set result k (s k + V.getOr (toUInt64 0) out k)) in
    St.freeze result)

-- --- hashers ------------------------------------------------------------------------------

@pub data Algorithm = Sha224 | Sha256 | Sha384 | Sha512 | Sha512t224 | Sha512t256

-- A hash being computed: the state, the bytes not yet making a block, and how
-- many bytes have gone in.
@pub record Hasher = {
  algorithm : Algorithm,
  state32 : #[UInt32],
  state64 : #[UInt64],
  pending : #[UInt8],
  total : Int
}

fun wide alg =
  match alg with
  | Algorithm.Sha224 -> False
  | Algorithm.Sha256 -> False
  | _ -> True

-- How many bytes the digest has.
@pub fun outputSize alg =
  match alg with
  | Algorithm.Sha224 -> 28
  | Algorithm.Sha256 -> 32
  | Algorithm.Sha384 -> 48
  | Algorithm.Sha512 -> 64
  | Algorithm.Sha512t224 -> 28
  | Algorithm.Sha512t256 -> 32

-- A hasher with nothing in it yet.
@pub fun new alg =
  let s32 =
    match alg with
    | Algorithm.Sha224 -> words32 h224
    | Algorithm.Sha256 -> words32 h256
    | _ -> #[]
  in
  let s64 =
    match alg with
    | Algorithm.Sha384 -> words64 h384
    | Algorithm.Sha512 -> words64 h512
    | Algorithm.Sha512t224 -> words64 h512t224
    | Algorithm.Sha512t256 -> words64 h512t256
    | _ -> #[]
  in
  Hasher { algorithm = alg, state32 = s32, state64 = s64, pending = #[], total = 0 }

-- `h` after every whole block of `bytes`, with what is left over pending.
fun absorb (h : Hasher) (bytes : #[UInt8]) =
  let size = if wide h.algorithm then 128 else 64 in
  let blocks = arrayLen bytes / size in
  let rec go k s32 s64 =
    if k >= blocks
    then { h | state32 = s32, state64 = s64, pending = arraySlice bytes (blocks * size) (arrayLen bytes) }
    else if wide h.algorithm
    then go (k + 1) s32 (compress64 s64 bytes (k * size))
    else go (k + 1) (compress32 s32 bytes (k * size)) s64
  in
  go 0 h.state32 h.state64

-- `h` with `bytes` added.
@pub fun update (h : Hasher) (bytes : #[UInt8]) =
  let absorbed = absorb h (arrayConcat h.pending bytes) in
  { absorbed | total = h.total + arrayLen bytes }

-- The digest of everything added to `h`.
@pub fun finalize (h : Hasher) =
  let size = if wide h.algorithm then 128 else 64 in
  let lengthBytes = if wide h.algorithm then 16 else 8 in
  let used = arrayLen h.pending + 1 + lengthBytes in
  let padded = (used + size - 1) / size * size in
  let bits = h.total * 8 in
  let tail =
    runSt (\() ->
      let t = St.newArray padded (toUInt8 0) in
      let _ = St.forRange 0 (arrayLen h.pending) (\i -> St.set t i (arrayGet h.pending i)) in
      let _ = St.set t (arrayLen h.pending) (toUInt8 0x80) in
      let _ = St.forRange 0 8 (\k -> St.set t (padded - 1 - k) (toUInt8 (bitAnd (bits >> (8 * k)) 255))) in
      St.freeze t)
  in
  let done = absorb { h | pending = #[] } tail in
  let n = outputSize h.algorithm in
  runSt (\() ->
    let out = St.newArray n (toUInt8 0) in
    let _ =
      if wide h.algorithm
      then St.forRange 0 n (\i -> St.set out i (toUInt8 (arrayGet done.state64 (i / 8) >> (8 * (7 - i % 8)))))
      else St.forRange 0 n (\i -> St.set out i (toUInt8 (arrayGet done.state32 (i / 4) >> (8 * (3 - i % 4)))))
    in
    St.freeze out)

-- The digest of `bytes` by `alg`.
@pub fun digest alg (bytes : #[UInt8]) = finalize (update (new alg) bytes)

-- The digest of the UTF-8 of `s` by `alg`.
@pub fun digestString alg s = digest alg (stringToBytes s)

@pub fun sha224 bytes = digest Algorithm.Sha224 bytes

@pub fun sha256 bytes = digest Algorithm.Sha256 bytes

@pub fun sha384 bytes = digest Algorithm.Sha384 bytes

@pub fun sha512 bytes = digest Algorithm.Sha512 bytes

-- Bytes as lower-case hex, as digests are usually shown.
@pub fun toHex (bytes : #[UInt8]) =
  let digit = \d -> if d < 10 then 48 + d else 87 + d in
  bytesToString
    (runSt (\() ->
      let n = arrayLen bytes in
      let out = St.newArray (2 * n) (toUInt8 0) in
      let _ =
        St.forRange 0 n (\i ->
          let b = toInt (arrayGet bytes i) in
          let _ = St.set out (2 * i) (toUInt8 (digit (b / 16))) in
          St.set out (2 * i + 1) (toUInt8 (digit (b % 16))))
      in
      St.freeze out))
